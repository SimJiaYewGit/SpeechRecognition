# Paths are relative to backend/, regardless of the launch directory.
DATABASE_PATH=data/transcriptions.sqlite3
UPLOAD_DIR=data/uploads
MODEL_CACHE_DIR=.cache/huggingface

# Limits: 25 MiB per HTTP request and 10 minutes of decoded audio.
# The audio decoder enforces duration; Flask enforces request bytes.
MAX_CONTENT_LENGTH=26214400
MAX_AUDIO_DURATION_SECONDS=600

# Local development server. Use a production WSGI server for deployment.
HOST=127.0.0.1
PORT=5000
